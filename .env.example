# Copy to .env.local and fill in as each integration is provisioned.
# Nothing here is required to run `npm run dev` / `npm run build` today —
# the site works fully without any of these set. See ARCHITECTURE.md.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://noafricanchildleftbehind.org

# --- Sanity (CMS) — spec section 64 ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# --- Database (Postgres / Supabase) — spec section 61, 66 ---
DATABASE_URL=

# --- Stripe (Payments) — spec section 39, 98 ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Auth (donor accounts, admin) — spec section 43, 65 ---
AUTH_SECRET=

# --- Transactional email — spec section 78, 41 ---
# One of: Resend, Postmark, SendGrid, Amazon SES
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=hello@noafricanchildleftbehind.org

# --- Analytics — spec section 74 ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Error monitoring — spec section 99 ---
SENTRY_DSN=
