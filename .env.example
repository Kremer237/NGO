# Copy to .env.local and fill in as each integration is provisioned.
# Nothing here is required to run `npm run dev` / `npm run build` today —
# the site works fully without any of these set. See ARCHITECTURE.md.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://noafricanchildleftbehind.org

# --- Sanity (CMS) — spec section 64 ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# --- Database (Postgres / Supabase) — spec section 61, 66 ---
# Now actually used: admin accounts, RBAC, and DB-backed Stories (blog
# posts) all need this. Run db/migrations/*.sql against it, then
# `npm run create-admin` to bootstrap the first account. See db/README.md.
DATABASE_URL=

# --- Stripe (Payments) — spec section 39, 98 ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Admin auth (personnel accounts, RBAC) — spec section 65 ---
# Now actually used, signs admin session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# --- Image storage for admin-uploaded post images ---
# Optional. Without it, uploads write to public/uploads/ on local disk —
# fine for local dev, NOT viable on Vercel or other serverless hosts
# (read-only/ephemeral filesystem at runtime). Set this once Blob storage
# is enabled on the Vercel project to switch automatically — see
# lib/storage.ts.
BLOB_READ_WRITE_TOKEN=

# --- Donor accounts (spec section 43, deferred to V1.1) ---
# Not built yet — see ARCHITECTURE.md.

# --- Transactional email — spec section 78, 41 ---
# Currently wired to Resend (lib/email.ts) — Contact and Volunteer form
# submissions are emailed on receipt. Get a key at resend.com.
EMAIL_PROVIDER_API_KEY=
# Sender address. Defaults to Resend's shared onboarding@resend.dev until a
# real domain is verified in the Resend dashboard.
EMAIL_FROM_ADDRESS=hello@noafricanchildleftbehind.org
# Inbox that receives form submissions. Defaults to
# noafricanchildleftbehind@outlook.com if unset.
EMAIL_TO_ADDRESS=noafricanchildleftbehind@outlook.com

# --- Analytics — spec section 74 ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Error monitoring — spec section 99 ---
SENTRY_DSN=
